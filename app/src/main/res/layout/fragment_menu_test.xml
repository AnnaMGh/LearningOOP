<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bar"
    android:gravity="center"
    android:orientation="vertical">


    <ListView
        android:id="@+id/menutest_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/menutest_footer"
        android:layout_alignParentTop="true"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/menutest_footer"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="40dp"
        android:layout_marginStart="40dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="100">

        <Button
            android:id="@+id/menutest_add_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="49.5"
            android:background="@drawable/rounded_darkblue"
            android:fontFamily="@font/lato_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="Add test"
            android:textAllCaps="false"
            android:textColor="#fff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#fff" />

        <Button
            android:id="@+id/menutest_remove_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="49.5"
            android:background="@drawable/rounded_darkblue"
            android:fontFamily="@font/lato_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="Remove test"
            android:textAllCaps="false"
            android:textColor="#fff"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>


</RelativeLayout>