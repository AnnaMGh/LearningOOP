<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--question-->
    <LinearLayout
        android:id="@+id/layout_question_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/rounded_blue"
        android:orientation="vertical">


        <!--qurstion type + delete-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--txt choose type-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_margin="10dp"
                android:fontFamily="@font/lato_regular"
                android:text="@string/str_question_type"
                android:textColor="@color/colorWhite"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_remove"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_margin="10dp"
                android:src="@drawable/remove" />

        </RelativeLayout>


        <!--type-->
        <RadioGroup
            android:id="@+id/rd_gr_type"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <RadioButton
                android:id="@+id/rd_btn_type_simple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checked="true"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:tag="1"
                android:text="@string/str_type_simple"
                android:textColor="#fff"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rd_btn_type_insert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:tag="2"
                android:text="@string/str_type_insert"
                android:textColor="#fff"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rd_btn_type_multiple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:tag="3"
                android:text="@string/str_type_multiple"
                android:textColor="#fff"
                android:textSize="15sp" />

        </RadioGroup>

        <!--type simple-->
        <LinearLayout
            android:id="@+id/layout_simple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/edt_simple_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_question_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />


            <EditText
                android:id="@+id/edt_simple_ansewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_answer_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />

        </LinearLayout>

        <!--type insert-->
        <LinearLayout
            android:id="@+id/layout_insert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edt_insert_question1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_question_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edt_insert_ansewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_answer_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edt_insert_question2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_question_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />

        </LinearLayout>

        <!--type multiple-->
        <LinearLayout
            android:id="@+id/layout_multiple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edt_multiple_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:hint="@string/str_question_no"
                android:inputType="text"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:textColor="#fff"
                android:textColorHint="#bbb"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/rd_gr_multiple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="10"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rd_btn_multiple_answer_1"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:textColor="#fff"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rd_btn_multiple_answer_2"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:textColor="#fff"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rd_btn_multiple_answer_3"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:textColor="#fff"
                        android:textSize="15sp" />

                </RadioGroup>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="90"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/edt_multiple_answer1"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:hint="@string/str_answer_no"
                        android:inputType="text"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:singleLine="true"
                        android:textColor="#fff"
                        android:textColorHint="#bbb"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/edt_multiple_answer2"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:hint="@string/str_answer_no"
                        android:inputType="text"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:singleLine="true"
                        android:textColor="#fff"
                        android:textColorHint="#bbb"
                        android:textSize="15sp" />


                    <EditText
                        android:id="@+id/edt_multiple_answer3"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="@font/lato_regular"
                        android:hint="@string/str_answer_no"
                        android:inputType="text"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:singleLine="true"
                        android:textColor="#fff"
                        android:textColorHint="#bbb"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

    <!--add new question-->
    <LinearLayout
        android:id="@+id/layout_add"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/rounded_blue"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="5dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_regular"
            android:padding="5dp"
            android:text="Add"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/add" />

    </LinearLayout>
</LinearLayout>