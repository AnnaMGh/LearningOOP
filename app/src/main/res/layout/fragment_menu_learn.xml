<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bar">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:id="@+id/menulearn_parent_lyt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="38dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/menulearn_img1"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:src="@drawable/learn_level_base"
                app:civ_border_color="#fff"
                app:civ_border_width="2dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/menulearn_img2"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/level_lock"
                app:civ_border_color="#fff"
                app:civ_border_width="2dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/menulearn_img3"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_below="@id/menulearn_img1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:src="@drawable/level_lock"
                app:civ_border_color="#fff"
                app:civ_border_width="2dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/menulearn_img4"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_below="@id/menulearn_img3"
                android:layout_marginTop="20dp"
                android:src="@drawable/level_lock"
                app:civ_border_color="#fff"
                app:civ_border_width="2dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/menulearn_img5"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/menulearn_img3"
                android:layout_marginTop="20dp"
                android:src="@drawable/level_lock"
                app:civ_border_color="#fff"
                app:civ_border_width="2dp" />

        </RelativeLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/menulearn_footer"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="100">

        <Button
            android:id="@+id/menulearn_add_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="49.5"
            android:background="@drawable/rounded_darkblue"
            android:fontFamily="@font/lato_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="Add lesson"
            android:textAllCaps="false"
            android:textColor="#fff"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#fff" />

        <Button
            android:id="@+id/menulearn_remove_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="49.5"
            android:background="@drawable/rounded_darkblue"
            android:fontFamily="@font/lato_regular"
            android:gravity="center"
            android:padding="5dp"
            android:text="Remove lesson"
            android:textAllCaps="false"
            android:textColor="#fff"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>