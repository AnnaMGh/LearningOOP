<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_darkblue"
        android:orientation="vertical"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingEnd="5dp"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:weightSum="100">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:gravity="start">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/listcell_img"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/user" />
            </LinearLayout>

            <TextView
                android:id="@+id/listcell_id"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="20"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:padding="5dp"
                android:text="Id: 100"
                android:textColor="#fff"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/listcell_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="64"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:text="Ghizdavat Ana-Maria"
                android:textColor="#fff"
                android:textSize="15sp" />


        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.05">
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/colorGray" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9"
            android:orientation="horizontal"
            android:paddingEnd="5dp"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:weightSum="90">

            <TextView
                android:id="@+id/listcell_learn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="29"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:text="Learn progress: 100%"
                android:textColor="#fff" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorGray" />
            </LinearLayout>



            <TextView
                android:id="@+id/listcell_test"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:text="Test progress: 100% "
                android:textColor="#fff" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorGray" />
            </LinearLayout>

            <TextView
                android:id="@+id/listcell_points"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="29"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:text="Points: 1600"
                android:textColor="#fff" />

        </LinearLayout>

        <Button
            android:id="@+id/listcell_btn"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/lato_regular"
            android:text="Delete account"
            android:textAllCaps="false"
            android:textColor="#000" />


    </LinearLayout>

</RelativeLayout>